<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/adminSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <div class="p-8 max-w-4xl w-full mx-auto space-y-6">
            
            <% if (success) { %>
                <div class="p-4 bg-teal-50 border border-teal-200 text-[#0F766E] rounded-xl text-xs font-bold flex items-center gap-2">
                    <i class="ti ti-circle-check text-base"></i> <%= success %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="p-4 bg-rose-50 border border-rose-200 text-rose-600 rounded-xl text-xs font-bold flex items-center gap-2">
                    <i class="ti ti-alert-circle text-base"></i> <%= error %>
                </div>
            <% } %>

            <div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Active Bookings Monitor</h1>
                <p class="text-sm text-slate-500">Live operational feed monitoring current infrastructure reservations across the company cluster.</p>
            </div>

            <div class="bg-white border border-slate-200 rounded-[20px] shadow-sm max-h-[550px] overflow-y-auto custom-scrollbar divide-y divide-slate-100">
                <% if (activeBookings && activeBookings.length > 0) { %>
                    <% activeBookings.forEach(booking => { %>
                        <div class="flex items-center px-6 py-4.5 justify-between hover:bg-slate-50/30 transition-all">
                            
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-700 flex-shrink-0 animate-pulse">
                                    <i class="ti ti-activity-heartbeat text-lg"></i>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="font-bold text-slate-800 text-sm truncate"><%= booking.resourceName %></h4>
                                    <p class="text-xs text-slate-400 mt-0.5 truncate">
                                        Occupied by <span class="font-bold text-slate-600"><%= booking.employeeName %></span>
                                    </p>
                                </div>
                            </div>

                            <form action="/admin/bookings/cancel" method="POST" onsubmit="return confirm('ADMINISTRATIVE OVERRIDE WARNING:\n\nAre you sure you want to forcibly terminate this employee reservation slot? The resource will immediately cycle back to an available status.');" class="flex-shrink-0">
                                <input type="hidden" name="bId" value="<%= booking.bId %>">
                                <input type="hidden" name="resourceName" value="<%= booking.resourceName %>">
                                <input type="hidden" name="employeeName" value="<%= booking.employeeName %>">
                                <button type="submit" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-100 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all active:scale-95 shadow-sm">
                                    Revoke Slot
                                </button>
                            </form>

                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-20 text-slate-400 text-xs italic">
                        No system allocations are currently active or checkouts deployed across node arrays right now.
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #E2E8F0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #CBD5E1; }
</style>

</body>
</html>