<%- include('../partials/header') %>

<div class="min-h-screen bg-slate-50 flex">
    <%- include('../partials/sidebar') %>

    <div class="flex-1">
        <%- include('../partials/navbar') %>

        <main class="p-8">
            <div class="flex items-start mb-8">
                <a href="/superadmin/organizations" class="mr-4 p-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 text-slate-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900"><%= stats.org_name %></h1>
                    <div class="flex items-center mt-1">
                        <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-0.5 rounded mr-2">ORG-<%= orgId %></span>
                        <span class="text-slate-500 text-sm italic">Administrative Overview</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-slate-400 text-xs uppercase font-bold">Total Users</p>
                    <p class="text-3xl font-black text-slate-800"><%= stats.total_org_users %></p>
                </div>
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-slate-400 text-xs uppercase font-bold">Resources</p>
                    <p class="text-3xl font-black text-slate-800"><%= stats.total_org_resources %></p>
                </div>
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-slate-400 text-xs uppercase font-bold">Bookings</p>
                    <p class="text-3xl font-black text-slate-800"><%= stats.total_org_bookings %></p>
                </div>
            </div>

            <div class="mb-10">
                <h3 class="text-lg font-bold text-slate-800 mb-4 px-1">Registered Users</h3>
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-y-auto max-h-[300px]">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase sticky top-0 z-10">
                            <tr>
                                <th class="px-6 py-3">User Name</th>
                                <th class="px-6 py-3">Email Address</th>
                                <th class="px-6 py-3">Role</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% users.forEach(user => { %>
                                <tr class="hover:bg-slate-50 text-sm text-slate-700">
                                    <td class="px-6 py-4 font-bold"><%= user.Name %></td>
                                    <td class="px-6 py-4"><%= user.Email %></td>
                                    <td class="px-6 py-4"><%= user.Role_Name %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mb-10">
                <h3 class="text-lg font-bold text-slate-800 mb-4 px-1">Resources by Category</h3>
                <div class="space-y-6">
                    <% categories.forEach(cat => { %>
                        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                            <h4 class="font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 uppercase text-xs tracking-wider">
                                <%= cat.Category_Name %>
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                                <% const catRes = resources.filter(r => r.Cat_id === cat.Cat_id); %>
                                <% if(catRes.length > 0) { %>
                                    <% catRes.forEach(res => { %>
                                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg flex justify-between items-center">
                                            <span class="text-sm font-medium text-slate-700"><%= res.Res_name %></span>
                                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded <%= res.Status === 'Available' ? 'bg-green-100 text-green-700' : 'bg-orange-100 text-orange-700' %>">
                                                <%= res.Status %>
                                            </span>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No resources found.</p>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="mb-10">
                <h3 class="text-lg font-bold text-slate-800 mb-4 px-1">All Bookings</h3>
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-y-auto max-h-[300px]">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase sticky top-0 z-10">
                            <tr>
                                <th class="px-6 py-3">Resource</th>
                                <th class="px-6 py-3">User Name</th>
                                <th class="px-6 py-3">Time Period</th>
                                <th class="px-6 py-3 text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% bookings.forEach(booking => { %>
                                <tr class="text-sm text-slate-700">
                                    <td class="px-6 py-4 font-bold text-slate-900"><%= booking.Res_Name %></td>
                                    <td class="px-6 py-4"><%= booking.user_name %></td>
                                    <td class="px-6 py-4 text-xs">
                                        <%= new Date(booking.Start_Time).toLocaleString() %> - 
                                        <%= new Date(booking.End_Time).toLocaleString() %>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="px-2 py-1 bg-slate-100 rounded text-xs"><%= booking.Status %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mb-10">
                <h3 class="text-lg font-bold text-slate-800 mb-4 px-1">System Audit Logs</h3>
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-y-auto max-h-[300px]">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase sticky top-0 z-10">
                            <tr>
                                <th class="px-6 py-3">Timestamp</th>
                                <th class="px-6 py-3">Operator</th>
                                <th class="px-6 py-3">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (logs && logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr class="hover:bg-slate-50 text-sm text-slate-700">
                                        <td class="px-6 py-4 text-slate-500">
                                            <%= new Date(log.Timestamp).toLocaleString() %>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-slate-900">
                                            <span class="text-xs text-slate-400 font-mono">ID: #<%= log.U_id %></span>
                                            <span class="ml-2"><%= log.Name || 'System Process' %></span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded text-[10px] font-bold uppercase tracking-wide">
                                                <%= log.Action %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="px-6 py-8 text-center text-slate-400 italic">
                                        No activity recorded for this organization yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<%- include('../partials/footer') %>