                        src="/images/AssetFlowIllustration.png" 
                        alt="Asset Management Illustration"
                        class="w-full h-auto drop-shadow-2xl mr-16"
                    >
             </div>
            </div>
        </div>

        
    </section>

    <section id="access" class="bg-[#F0FDFA] py-20 px-10">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl font-black mb-6 tracking-tight text-[#0F766E]">Access Your Workspace</h2>
            <div class="grid md:grid-cols-2 gap-12">
                <div class="bg-white p-10 rounded-2xl shadow-sm border border-[#CCFBF1] flex flex-col justify-between">
                    <div>
                        <h3 class="text-2xl font-black text-[#111827] mb-4">Register Organization</h3>
                        <p class="text-[#6B7280] leading-relaxed mb-8">
                            Establish a dedicated workspace for your enterprise. Define administrative control, manage multi-tenant permissions, and begin tracking your organizational infrastructure today.
                        </p>
                    </div>
                    <div class="flex space-x-4">
                        <a href="/register" class="flex-1 text-center bg-[#0F766E] text-white py-4 rounded-xl font-bold hover:bg-[#14B8A6] transition-all">New Organization</a>
                    </div>
                </div>

                <div class="bg-white p-10 rounded-2xl shadow-xl flex flex-col justify-between">
                    <div>
                        <h3 class="text-2xl font-black text-black mb-4">System Access</h3>
                        <p class="text-slate-400 leading-relaxed mb-8">
                            Continue your workflow and manage active asset lifecycles. Access your global dashboard to review maintenance schedules and immutable audit logs.
                        </p>
                    </div>
                    <a href="/login" class="block text-center bg-[#0F766E]  text-white py-4 rounded-xl font-bold hover:bg-[#14B8A6] transition-all">Log In to Account</a>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="bg-[#134E4A] py-24 px-10 text-white">
        <div class="max-w-7xl mx-auto">
            <div class="max-w-3xl mb-16">
