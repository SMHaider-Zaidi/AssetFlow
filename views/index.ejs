        </div>
    </header>

    <section class="relative pt-12 pb-32 px-10 overflow-hidden border-b border-slate-50">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center relative z-10">
            
            <div class="space-y-8">
                <h2 class="text-6xl font-black text-[#111827] leading-[1.1] tracking-tight">
                    Everything Your Assets Need, <br>
                    <span class="text-[#0F766E]">In One System</span>
                </h2>

                <p class="text-[#6B7280] text-lg leading-relaxed max-w-lg">
                    Experience the future of organizational resource management. Leveraging advanced lifecycle tracking, multi-tenant architecture, and automated maintenance scheduling for seamless and secure operations.
                </p>
                
            
            </div>

            <div class="relative flex justify-center">
                <div class="w-full max-w-xl">
