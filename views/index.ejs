                <a href="#about" class="hover:text-[#0F766E] transition-colors">About</a>
                <a href="#contact" class="hover:text-[#0F766E] transition-colors">Contact</a>
                 <a href="/login" class="underline decoration-[#0F766E] text-[#0F766E] transition-colors">Login</a>
