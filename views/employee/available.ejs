<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/employeeSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <div class="p-8 max-w-full w-full">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Available Resources</h1>
                <p class="text-sm text-slate-500 mt-1">All resources currently available for booking.</p>
            </div>

            <% if (availableResources && availableResources.length > 0) { %>
                <%
                    const grouped = {};
                    availableResources.forEach(r => {
                        const cat = r.Category_Name || 'Uncategorized';
                        if (!grouped[cat]) grouped[cat] = [];
                        grouped[cat].push(r);
                    });
                    const categoryNames = Object.keys(grouped);
                %>

                <% categoryNames.forEach(catName => { %>
                    <div class="mb-8">
                        <div class="flex items-center justify-between mb-3 px-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]"><%= catName %></p>
                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-md font-bold">
                                <%= grouped[catName].length %> Available
                            </span>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                            <% grouped[catName].forEach((resource, index) => { %>
                                <div class="flex items-center px-6 py-4 <%= index < grouped[catName].length - 1 ? 'border-b border-slate-100' : '' %> hover:bg-slate-50 transition-colors group">
                                    <div class="flex items-center flex-1 min-w-0">
                                        <div class="w-9 h-9 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0 mr-4 group-hover:bg-teal-600 transition-colors duration-200">
                                            <i class="ti ti-box-seam text-[#0F766E] group-hover:text-white text-lg"></i>
                                        </div>
                                        <span class="text-sm font-semibold text-slate-800 group-hover:text-[#134E4A] truncate">
                                            <%= resource.Res_name %>
                                        </span>
                                    </div>
                                    <div class="flex-1 flex justify-center">
                                        <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-3 py-1 rounded-full uppercase tracking-widest">
                                            <%= resource.Status %>
                                        </span>
                                    </div>
                                    <div class="flex-1 flex justify-end">
                                        <button onclick="openBookingModal('<%= resource.Res_id %>', '<%= resource.Res_name.replace(/'/g, "\\'") %>')"
                                            class="flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-200 rounded-lg text-[11px] font-black text-slate-700 uppercase tracking-widest hover:bg-[#134E4A] hover:text-white transition-all active:scale-95">
                                            <i class="ti ti-calendar-plus text-sm"></i> Book
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>
</div>

<div id="booking-overlay" onclick="handleOverlayClick(event)"
    class="fixed inset-0 bg-slate-900/50 flex items-center justify-center z-50 opacity-0 pointer-events-none transition-opacity duration-200">
    
    <div id="modal-container" class="bg-white rounded-2xl p-7 w-[400px] max-w-[95vw] border border-slate-200 shadow-xl transform scale-95 transition-transform duration-200">
        
        <div class="flex items-start justify-between mb-6">
            <div>
                <h2 class="text-base font-bold text-slate-900">Booking Details</h2>
                <p id="modal-resource-name" class="text-xs text-slate-500 mt-0.5 font-medium"></p>
            </div>
            <button onclick="closeBookingModal()" class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition-colors">
                <i class="ti ti-x text-slate-500 text-sm"></i>
            </button>
        </div>

        <form action="/employee/catalog/check" method="POST" id="booking-form">
            <input type="hidden" name="resId" id="modal-res-id" />
            
            <div class="mb-4">
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-0.5">Date</label>
                <div class="relative">
                    <i class="ti ti-calendar absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="date" name="date" id="book-date" required
                        class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:outline-none focus:border-teal-500 transition-all">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-4">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-0.5">From</label>
                    <input type="time" name="startTime" id="book-from" required
                        class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:outline-none focus:border-teal-500 transition-all">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-0.5">Until</label>
                    <input type="time" name="endTime" id="book-until" required
                        class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:outline-none focus:border-teal-500 transition-all">
                </div>
            </div>

            <!-- Error lives here inside the modal, right above the button -->
            <p id="ui-time-error" class="text-[11px] text-red-600 font-bold hidden mb-4 text-center italic">
                * Invalid time: Must be in the future and end after start.
            </p>

            <button type="submit" class="w-full py-3 bg-[#134E4A] text-white rounded-xl text-[12px] font-black uppercase tracking-widest hover:bg-[#0F766E] transition-colors">
                Check & Confirm Booking
            </button>
        </form>
    </div>
</div>

<script>
    const overlay = document.getElementById('booking-overlay');
    const modalContainer = document.getElementById('modal-container');
    const timeError = document.getElementById('ui-time-error');

    document.getElementById('booking-form').addEventListener('submit', function(e) {
        const dateInput = document.getElementById('book-date').value;
        const startInput = document.getElementById('book-from').value;
        const endInput = document.getElementById('book-until').value;

        if (!dateInput || !startInput || !endInput) return;

        const [sH, sM] = startInput.split(':').map(Number);
        const [eH, eM] = endInput.split(':').map(Number);

        const bookingStart = new Date(dateInput);
        bookingStart.setHours(sH, sM, 0, 0);

        const bookingEnd = new Date(dateInput);
        bookingEnd.setHours(eH, eM, 0, 0);

        const gracedNow = new Date(Date.now() - 5 * 60 * 1000);
        gracedNow.setSeconds(0, 0);

        if (bookingEnd <= bookingStart) {
            e.preventDefault();
            timeError.textContent = '* End time must be after start time.';
            timeError.classList.remove('hidden');
            return;
        }

        if (bookingStart < gracedNow) {
            e.preventDefault();
            timeError.textContent = '* Start time cannot be in the past.';
            timeError.classList.remove('hidden');
            return;
        }

        timeError.classList.add('hidden');
    });

    function openBookingModal(resId, resName) {
        document.getElementById('modal-res-id').value = resId;
        document.getElementById('modal-resource-name').textContent = resName;
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('book-date').value = today;
        document.getElementById('book-from').value = '';
        document.getElementById('book-until').value = '';
        timeError.classList.add('hidden');
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        modalContainer.classList.remove('scale-95');
        modalContainer.classList.add('scale-100');
    }

    function closeBookingModal() {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        modalContainer.classList.remove('scale-100');
        modalContainer.classList.add('scale-95');
    }

    function handleOverlayClick(e) { if (e.target === overlay) closeBookingModal(); }
</script>

</body>
</html>