<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/employeeSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <!-- Centered Content -->
        <div class="flex-1 flex items-center justify-center p-8">

            <div class="w-full max-w-sm">

                <!-- Profile Card -->
                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden">

                    <!-- Top Teal Band + Avatar -->
                    <div class="bg-[#134E4A] px-6 pt-8 pb-10 flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center mb-3">
                            <span class="text-2xl font-bold text-white">
                                <%= user.userName.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                        <h2 class="text-base font-bold text-white tracking-tight"><%= user.userName %></h2>
                        <span class="mt-2 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-white/10 border border-white/20 text-teal-200">
                            <i class="ti ti-shield-check text-xs"></i>
                            <%= user.role %>
                        </span>
                    </div>

                    <!-- Details -->
                    <div class="px-6 py-5 space-y-4 -mt-1">

                        <!-- Name -->
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                <i class="ti ti-user text-slate-400 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Full Name</p>
                                <p class="text-sm font-semibold text-slate-800"><%= user.userName %></p>
                            </div>
                        </div>

                        <!-- Role -->
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                <i class="ti ti-id-badge text-slate-400 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Role</p>
                                <p class="text-sm font-semibold text-slate-800"><%= user.role %></p>
                            </div>
                        </div>

                        <!-- Organization -->
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                                <i class="ti ti-building text-teal-500 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Organization</p>
                                <p class="text-sm font-semibold text-slate-800">
                                    <%= organization ? organization.Org_name : user.orgName %>
                                </p>
                            </div>
                        </div>

                    </div>

                    <!-- Sign Out -->
                    <div class="px-6 pb-6">
                        <a href="/logout"
                            class="flex items-center justify-center gap-2 w-full py-2.5 bg-white border border-slate-200 rounded-xl text-[11px] font-black uppercase tracking-widest text-red-400 hover:bg-red-50 hover:border-red-200 transition-all">
                            <i class="ti ti-logout text-sm"></i>
                            Sign Out
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </main>
</div>

</body>
</html>