<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/employeeSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <div class="p-8 max-w-full w-full">
            
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Current and upcoming bookings</h1>
                <p class="text-sm text-slate-500 mt-1">Manage your active and upcoming resource bookings.</p>
            </div>

            <div class="mb-12">
                <div class="flex items-center gap-2 mb-6">
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    <h2 class="text-lg font-bold text-slate-800">In Progress</h2>
                </div>

                <% if (currentBookings && currentBookings.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% currentBookings.forEach(booking => { %>
                            <div class="bg-white border-2 border-emerald-100 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between mb-4">
                                        <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                                            <i class="ti ti-device-computer-camera text-xl"></i>
                                        </div>
                                        <span class="text-[10px] font-bold px-2 py-1 bg-emerald-50 text-emerald-700 rounded-md uppercase tracking-widest">Active</span>
                                    </div>
                                    <h3 class="font-bold text-slate-800"><%= booking.Res_Name %></h3>
                                    <p class="text-xs text-slate-500 mt-2">Ends at <%= new Date(booking.End_Time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></p>
                                </div>
                                
                                <button onclick="handleCancel('<%= booking.B_id %>')" 
                                        class="mt-4 w-full py-2 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors flex items-center justify-center gap-1">
                                    <i class="ti ti-trash"></i> Cancel Booking
                                </button>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="py-8 px-6 border border-dashed border-slate-200 rounded-2xl text-center">
                        <p class="text-sm text-slate-400">You aren't using any resources right now.</p>
                    </div>
                <% } %>
            </div>

            <div>
                <div class="flex items-center gap-2 mb-6">
                    <i class="ti ti-calendar-time text-slate-400 text-xl"></i>
                    <h2 class="text-lg font-bold text-slate-800">Upcoming Schedule</h2>
                </div>

                <% if (futureBookings && futureBookings.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% futureBookings.forEach(booking => { %>
                            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm opacity-90 hover:opacity-100 transition-all flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between mb-4">
                                        <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400">
                                            <i class="ti ti-clock-play text-xl"></i>
                                        </div>
                                        <button onclick="handleCancel('<%= booking.B_id %>')" class="text-slate-400 hover:text-rose-600 transition-colors">
                                            <i class="ti ti-x text-lg"></i>
                                        </button>
                                    </div>
                                    <h3 class="font-bold text-slate-800"><%= booking.Res_Name %></h3>
                                    <div class="mt-4 pt-4 border-t border-slate-50 text-xs text-slate-500 space-y-1">
                                        <p><i class="ti ti-calendar mr-1"></i> <%= new Date(booking.Start_Time).toLocaleDateString() %></p>
                                        <p><i class="ti ti-clock mr-1"></i> <%= new Date(booking.Start_Time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></p>
                                    </div>
                                </div>

                                <button onclick="handleCancel('<%= booking.B_id %>')" 
                                        class="mt-4 w-full py-2 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors flex items-center justify-center gap-1">
                                    <i class="ti ti-trash"></i> Cancel Booking
                                </button>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-400 italic pl-2">No future bookings scheduled.</p>
                <% } %>
            </div>

        </div>
    </main>
</div>

<form id="cancelForm" method="POST" action="" style="display: none;"></form>

<script>
    function handleCancel(bookingId) {
        if (confirm('Are you sure you want to cancel this booking?')) {
            const form = document.getElementById('cancelForm');
            // Setting the action dynamically based on the booking ID
            form.action = '/employee/cancel/' + bookingId; 
            form.submit();
        }
    }
</script>

</body>
</html>