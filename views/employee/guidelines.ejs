<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/employeeSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <div class="p-8 max-w-3xl w-full">

            <!-- Page Header -->
            <div class="mb-10">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Guidelines</h1>
                <p class="text-sm text-slate-500 mt-1">Please read and follow these policies when booking resources.</p>
            </div>

            <%
                const icons = [
                    'ti-calendar-time',
                    'ti-shield-check',
                    'ti-arrow-back',
                    'ti-lock'
                ];
                const colors = [
                    { bg: 'bg-teal-50',   icon: 'text-teal-600',  border: 'border-teal-100',  num: 'text-teal-200'  },
                    { bg: 'bg-blue-50',   icon: 'text-blue-500',  border: 'border-blue-100',  num: 'text-blue-200'  },
                    { bg: 'bg-amber-50',  icon: 'text-amber-500', border: 'border-amber-100', num: 'text-amber-200' },
                    { bg: 'bg-purple-50', icon: 'text-purple-500',border: 'border-purple-100',num: 'text-purple-200'},
                ];
            %>

            <!-- Guidelines Cards -->
            <div class="space-y-4">
                <% guidelines.forEach((g, index) => { %>
                    <% const color = colors[index % colors.length]; %>
                    <% const icon  = icons[index % icons.length]; %>

                    <div class="bg-white border border-slate-200 rounded-2xl px-6 py-5 flex items-start gap-5 hover:border-slate-300 transition-colors group">

                        <!-- Icon Box -->
                        <div class="w-11 h-11 rounded-xl <%= color.bg %> border <%= color.border %> flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i class="ti <%= icon %> <%= color.icon %> text-xl"></i>
                        </div>

                        <!-- Text -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-3 mb-1">
                                <h2 class="text-sm font-bold text-slate-800"><%= g.title %></h2>
                            
                            </div>
                            <p class="text-sm text-slate-500 leading-relaxed"><%= g.content %></p>
                        </div>

                    </div>

                <% }) %>
            </div>

            <!-- Footer Note -->
            <div class="mt-8 flex items-start gap-3 bg-slate-100 border border-slate-200 rounded-2xl px-5 py-4">
                <i class="ti ti-info-circle text-slate-400 text-lg mt-0.5 flex-shrink-0"></i>
                <p class="text-xs text-slate-500 leading-relaxed">
                    These guidelines are set by your organization. For questions or exceptions, please contact your administrator.
                </p>
            </div>

        </div>
    </main>
</div>

</body>
</html>