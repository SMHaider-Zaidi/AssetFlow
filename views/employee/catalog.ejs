<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <style>
        /* Custom scrollbar configurations for separate category elements */
        .category-scroll::-webkit-scrollbar {
            width: 5px;
        }
        .category-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
        }
        .category-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .category-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] font-sans text-slate-900">

<div class="flex min-h-screen">
    <%- include('../partials/employeeSidebar') %>

    <main class="flex-1 flex flex-col min-w-0 ml-64">
        <%- include('../partials/navbar') %>

        <div class="p-8 max-w-6xl w-full mx-auto">

            <div class="mb-8">
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-teal-50 text-[#0F766E] text-[10px] font-black uppercase tracking-[0.15em] border border-teal-100">
                        <i class="ti ti-building-community mr-1 text-xs"></i>
                        <%= user.orgName %>
                    </span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Resource Catalog</h1>
                <p class="text-sm text-slate-500">Browse and book available resources for your projects.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-700 shadow-sm">
                    <i class="ti ti-alert-circle text-lg"></i>
                    <p class="text-xs font-bold"><%= error %></p>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-emerald-700 shadow-sm">
                    <i class="ti ti-circle-check text-lg"></i>
                    <p class="text-xs font-bold"><%= success %></p>
                </div>
            <% } %>

            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <% const categoryResources = allResources.filter(r => r.Cat_id === category.Cat_id); %>
                    
                    <div class="mb-10">
                        <div class="flex items-center justify-between mb-3 px-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">
                                <%= category.Category_Name %>
                            </p>
                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2.5 py-0.5 rounded-md font-bold">
                                <%= categoryResources.length %> <%= categoryResources.length === 1 ? 'Item' : 'Items' %> Listed
                            </span>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-[20px] shadow-sm overflow-hidden flex flex-col">
                            <div class="category-scroll overflow-y-auto max-h-[300px] divide-y divide-slate-100">
                                <% if (categoryResources.length > 0) { %>
                                    <% categoryResources.forEach((resource) => { %>
                                        <div class="flex items-center px-6 py-4 hover:bg-slate-50/60 transition-all group">

                                            <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0 mr-4 group-hover:bg-[#134E4A] transition-all duration-300">
                                                <i class="ti ti-box-seam text-[#0F766E] text-xl group-hover:text-white"></i>
                                            </div>

                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center gap-2">
                                                    <h3 class="text-[15px] font-bold text-slate-800 group-hover:text-[#134E4A] transition-colors truncate">
                                                        <%= resource.Res_name %>
                                                    </h3>
                                                    <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                                    
                                                    <% if (resource.Status === 'Available') { %>
                                                        <span class="text-[11px] text-teal-600 font-bold uppercase tracking-tight">Available</span>
                                                    <% } else if (resource.Status === 'Maintenance') { %>
                                                        <span class="text-[11px] text-rose-600 font-bold uppercase tracking-tight">Maintenance</span>
                                                    <% } else if (resource.Status === 'Occupied') { %>
                                                        <span class="text-[11px] text-amber-600 font-bold uppercase tracking-tight">Occupied</span>
                                                    <% } else { %>
                                                        <span class="text-[11px] text-slate-500 font-bold uppercase tracking-tight"><%= resource.Status %></span>
                                                    <% } %>
                                                </div>
                                                
                                                <p class="text-[12px] text-slate-400 mt-0.5 font-medium truncate max-w-md">
                                                    <% if (resource.Status === 'Occupied' && resource.End_Time) { %>
                                                        <% 
                                                            const time = new Date(resource.End_Time).toLocaleTimeString('en-US', { 
                                                                hour: '2-digit', 
                                                                minute: '2-digit', 
                                                                hour12: true 
                                                            }); 
                                                        %>
                                                        <span class="text-slate-600 font-semibold">Currently booked out until <%= time %></span>
                                                    <% } else if (resource.Status === 'Maintenance') { %>
                                                        <span class="text-rose-600/80 font-semibold italic">Temporarily offline for servicing upgrades.</span>
                                                    <% } else { %>
                                                        Standard <%= category.Category_Name %> configuration profile for workspace usage.
                                                    <% } %>
                                                </p>
                                            </div>

                                            <div class="ml-6">
                                                <% if (resource.Status === 'Available' || resource.Status === 'Occupied') { %>
                                                    <button
                                                        onclick="openBookingModal('<%= resource.Res_id %>', '<%= resource.Res_name.replace(/'/g, '\\\'') %>')"
                                                        class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg text-[11px] font-black text-slate-700 uppercase tracking-widest hover:bg-[#134E4A] hover:text-white hover:border-[#134E4A] transition-all active:scale-95">
                                                        <i class="ti ti-calendar-plus text-base"></i> Book
                                                    </button>
                                                <% } else if (resource.Status === 'Maintenance') { %>
                                                    <button disabled
                                                        class="flex items-center gap-2 px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-[11px] font-bold text-slate-400 uppercase tracking-widest cursor-not-allowed italic">
                                                        <i class="ti ti-tool text-base"></i> Locked
                                                    </button>
                                                <% } else { %>
                                                    <button disabled
                                                        class="flex items-center gap-2 px-4 py-2 bg-slate-50 border border-slate-100 rounded-lg text-[11px] font-bold text-slate-400 uppercase tracking-widest cursor-not-allowed">
                                                        Unavailable
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="text-center py-8 text-slate-400 italic text-xs">
                                        No active resources mapped within this category track container block currently.
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 text-center bg-white border border-slate-200 rounded-[20px] shadow-sm">
                    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                        <i class="ti ti-package-off text-slate-300 text-3xl"></i>
                    </div>
                    <h2 class="text-sm font-bold text-slate-900">No Classification Groups Available</h2>
                    <p class="text-xs text-slate-400 mt-1">Please wait for system administrators to deploy organization asset groups.</p>
                </div>
            <% } %>
        </div>
    </main>
</div>

<div id="booking-overlay" onclick="handleOverlayClick(event)"
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-[60] opacity-0 pointer-events-none transition-all duration-300">
    
    <div class="bg-white rounded-[24px] p-8 w-[420px] max-w-[95vw] shadow-2xl transform scale-95 transition-transform duration-300" id="modal-container">
        
        <div class="flex items-start justify-between mb-6">
            <div>
                <h2 class="text-xl font-bold text-slate-900 tracking-tight">Booking Details</h2>
                <p id="modal-resource-name" class="text-xs text-slate-500 mt-0.5 font-medium"></p>
            </div>
            <button onclick="closeBookingModal()" class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center hover:bg-slate-200 transition-colors text-slate-500">
                <i class="ti ti-x text-lg"></i>
            </button>
        </div>

        <form action="/employee/catalog/check" method="POST" id="booking-form" class="space-y-5">
            <input type="hidden" name="resId" id="modal-res-id" />
            
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-1">Date</label>
                <div class="relative">
                    <i class="ti ti-calendar absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="date" name="date" id="book-date" required 
                           class="w-full pl-11 pr-4 py-3 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:ring-4 focus:ring-teal-500/10 focus:border-teal-500 transition-all outline-none">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-1">From</label>
                    <input type="time" name="startTime" id="book-from" required 
                           class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:ring-4 focus:ring-teal-500/10 focus:border-teal-500 transition-all outline-none">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 pl-1">Until</label>
                    <input type="time" name="endTime" id="book-until" required 
                           class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-slate-50 focus:ring-4 focus:ring-teal-500/10 focus:border-teal-500 transition-all outline-none">
                </div>
            </div>

            <p id="ui-time-error" class="text-[11px] text-rose-600 font-bold hidden text-center italic bg-rose-50/70 py-2 border border-rose-100 rounded-xl shadow-inner">
                * Error message placeholder
            </p>

            <button type="submit" class="w-full py-3.5 bg-[#134E4A] text-white rounded-xl text-[13px] font-black uppercase tracking-widest shadow-lg shadow-teal-900/20 hover:bg-[#0F766E] transition-all transform active:scale-[0.98]">
                Check & Confirm Booking
            </button>
        </form>
    </div>
</div>

<script>
    const overlay = document.getElementById('booking-overlay');
    const modalContainer = document.getElementById('modal-container');
    const timeError = document.getElementById('ui-time-error');

    // Scans URL queries to recover user visual state context if collision error triggers
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        const errorParam = urlParams.get('error');
        const targetResId = urlParams.get('resId');
        
        if (errorParam && (errorParam.includes('booked') || errorParam.includes('already') || errorParam.includes('slot'))) {
            if (timeError) {
                timeError.textContent = `* ${errorParam}`;
                timeError.classList.remove('hidden');
                openBookingModal(targetResId || '', 'Resource Status Verification Failed');
            }
        }
    });

    document.getElementById('booking-form').addEventListener('submit', function(e) {
        const dateVal = document.getElementById('book-date').value;
        const startVal = document.getElementById('book-from').value;
        const endVal = document.getElementById('book-until').value;

        if (!dateVal || !startVal || !endVal) return;

        const start = new Date(`${dateVal}T${startVal}`);
        const end = new Date(`${dateVal}T${endVal}`);
        const now = new Date();
        const bufferTime = new Date(now.getTime() - 120000); 

        if (end <= start) {
            e.preventDefault();
            timeError.textContent = '* End time must be after start time.';
            timeError.classList.remove('hidden');
        } else if (start < bufferTime) {
            e.preventDefault();
            timeError.textContent = '* Start time cannot be in the past.';
            timeError.classList.remove('hidden');
        } else {
            timeError.classList.add('hidden');
        }
    });

    function openBookingModal(resId, resName) {
        document.getElementById('modal-res-id').value = resId;
        document.getElementById('modal-resource-name').textContent = resName;
        
        const urlParams = new URLSearchParams(window.location.search);
        if (!urlParams.get('error')) {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('book-date').value = today;
            timeError.classList.add('hidden');
        }
        
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        modalContainer.classList.replace('scale-95', 'scale-100');
    }

    function closeBookingModal() {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        modalContainer.classList.replace('scale-100', 'scale-95');
        
        const url = new URL(window.location);
        url.searchParams.delete('error');
        url.searchParams.delete('resId');
        window.history.replaceState({}, document.title, url.pathname);
        timeError.classList.add('hidden');
    }

    function handleOverlayClick(e) { if (e.target === overlay) closeBookingModal(); }
</script>

</body>
</html>