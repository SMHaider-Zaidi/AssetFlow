<header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8 sticky top-0 z-10">
    
    <div class="flex items-center">
        <p class="text-sm font-black uppercase tracking-widest text-slate-900">
            <% if (locals.user && user.userName) { %>
                <%= user.userName %>
            <% } else { %>
                Guest
            <% } %>
        </p>
    </div>

    <div class="flex items-center">
        <form action="/logout" method="GET">
            <button type="submit" class="flex items-center gap-2 px-3 py-2 text-rose-500 hover:cursor-pointer transition-colors font-bold text-xs uppercase tracking-tight">
                <span>Logout</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
            </button>
        </form>
    </div>
</header>