<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error <%= statusCode %> | AssetFlow</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 font-sans min-h-screen flex items-center justify-center p-6">

    <div class="max-w-md w-full bg-white rounded-xl shadow-md border border-gray-100 p-8 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-teal-50 border border-teal-100 mb-6">
            <svg class="w-8 h-8 text-[#0F766E]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
        </div>

        <div class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-amber-700 bg-amber-50 border border-amber-200 rounded-full mb-3">
            Status Code: <%= statusCode %>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 mb-3">An Error Occurred</h1>
        <p class="text-gray-600 text-sm mb-8 leading-relaxed">
            <%= message %>
        </p>

        <div class="space-y-3">
            <a href="javascript:history.back()" class="block w-full text-center px-4 py-2.5 bg-[#0F766E] hover:bg-[#0d635c] text-white text-sm font-medium rounded-lg transition duration-150 shadow-sm">
                Go Back Safely
            </a>
            <a href="/dashboard" class="block w-full text-center px-4 py-2.5 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition duration-150">
                Return to Central Dashboard
            </a>
        </div>
    </div>

</body>
</html>