<%- include('partials/header') %>

<div class="min-h-screen bg-[#F0FDFA] flex items-center justify-center px-10 py-20">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-[#CCFBF1] overflow-hidden">
        <div class="p-10">
            <div class="mb-8 text-center">
                <div class="inline-flex w-12 h-12 bg-[#0F766E] rounded-xl items-center justify-center text-white mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                </div>
                <h2 class="text-3xl font-black text-[#111827] tracking-tight">Welcome Back</h2>
                <p class="text-sm text-[#6B7280] mt-2">Access your organization's asset dashboard</p>
            </div>

            <form action="/login" method="POST" class="space-y-6">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-[#0F766E] mb-2">Email Address</label>
                    <input type="email" name="email" required placeholder="name@company.com" 
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:border-transparent transition-all text-sm">
                </div>
                <div>
                    <div class="flex justify-between mb-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-[#0F766E]">Password</label>
                    </div>
                    <input type="password" name="password" required placeholder="••••••••" 
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:border-transparent transition-all text-sm">
                </div>
                <button type="submit" class="w-full bg-[#111827] hover:bg-[#0F766E] text-white py-4 rounded-xl font-bold text-sm shadow-lg transition-all transform active:scale-95 uppercase tracking-widest">
                    Authorize Access
                </button>
            </form>

            <div class="mt-8 pt-8 border-t border-slate-100 text-center">
                <p class="text-xs text-[#6B7280] font-bold">New to AssetFlow? <a href="/register" class="text-[#0F766E] hover:underline">Create Organization</a></p>
            </div>
            <p class="mt-4 text-center">
                <a href="/" class="text-[12px] text-[#6B7280] font-bold hover:underline">Back to Home</a>
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>